# ==========================================
# Forever E-Commerce Backend - environment template
# Copy to .env and fill in real values. Never commit .env.
# ==========================================

NODE_ENV=development

# Server & Network URLs
PORT=4000
BACKEND_URL=http://localhost:4000

# Client application URLs (used for the CORS allowlist and links in emails)
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
# Optional extra allowed origins, comma separated (e.g. preview deployments)
CORS_ORIGINS=

# Database (MongoDB Atlas or local)  [required]
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# JWT secrets  [required] - generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_TOKEN_SECRET=change_me
JWT_TOKEN_EXPIRE=7d
ADMIN_JWT_SECRET=change_me_to_a_different_value

# Env super-admin login. Leave ADMIN_PASSWORD empty to disable it.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Cloudinary media storage
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET_KEY=
CLOUDINARY_URL=

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Stripe (optional)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (review-approval notifications). Use SMTP_* or GMAIL_*; if neither is set, emails are logged to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Test-only switches - must stay false/unset in production
ALLOW_MOCK_PAYMENTS=false
ALLOW_UNSIGNED_WEBHOOKS=false
