# ------------------------------------------------------------
# Ignore rules for forever-backend
# ------------------------------------------------------------

# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases

# Environment & secrets (only the committed templates are allowed)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.crt
service-account*.json

# Next.js / build output
.next/
out/
dist/
dist-ssr/
build/
*.tsbuildinfo
next-env.d.ts

# Deployment
.vercel/
.netlify/

# Testing & coverage
coverage/
.nyc_output/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime / temp
tmp/
temp/
uploads/
*.pid
*.seed
.cache/
.eslintcache

# Editors & OS
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.sw?
.DS_Store
Thumbs.db
desktop.ini
